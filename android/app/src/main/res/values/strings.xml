    <string name="screen_control_label">FlyyLink computer control</string>
    <string name="screen_control_description">Lets your paired computer tap, swipe and type on this phone while you mirror its screen. It acts only on what you do in the mirror window, reads nothing else on screen, and collects or shares no data.</string>

    <string name="control_disclosure_title">Control your phone from your computer</string>
    <string name="control_disclosure_intro">FlyyLink uses an accessibility service, "FlyyLink computer control", so your paired computer\'s mouse and keyboard can work this phone while you mirror its screen.</string>
    <string name="control_disclosure_does">What it does</string>
    <string name="control_disclosure_taps">Taps, swipes and presses Back, Home, Recents and the notification shade where you click in the mirror window</string>
    <string name="control_disclosure_typing">Types into the text field you selected, reading only that field</string>
    <string name="control_disclosure_only">Works only while you mirror to a computer you paired</string>
    <string name="control_disclosure_data">Your data</string>
    <string name="control_disclosure_private">Reads, records and keeps nothing else on your screen</string>
    <string name="control_disclosure_local">Collects and shares no personal data. Clicks and typing go only between your own devices, encrypted</string>
    <string name="control_disclosure_settings">Next, turn on "FlyyLink computer control" in Accessibility settings. You can turn it off there any time.</string>
    <string name="control_disclosure_accept">Agree and continue</string>
    <string name="control_disclosure_decline">No thanks</string>

    <string name="location_disclosure_title">Find your phone from your computer</string>
    <string name="location_disclosure_intro">FlyyLink collects your phone\'s location to enable Find my phone, even when the app is closed or not in use.</string>
    <string name="location_disclosure_find">When a computer you paired asks to find this phone, FlyyLink sends it the phone\'s current location so it can show it on a map</string>
    <string name="location_disclosure_background">Works even when FlyyLink is closed or not in use, which is usually when a phone goes missing</string>
    <string name="location_disclosure_private">Reads the location only when you ask from your computer. FlyyLink doesn\'t track you or record where you go</string>
    <string name="location_disclosure_local">Your location goes only to your own paired computer, encrypted. It is never sent to us or anyone else, or used for ads</string>
    <string name="location_disclosure_prompt">Next, Android asks for location access. Choose "Allow all the time" so you can find your phone while FlyyLink is in the background.</string>

    <string name="phone_disclosure_title">Texts and calls on your computer</string>
    <string name="phone_disclosure_intro">FlyyLink syncs your phone\'s texts and calls with your paired Mac or PC, so you can read, reply and answer from your computer.</string>
    <string name="phone_disclosure_texts">Reads your SMS conversations to show them on your computer, and sends the replies you write there</string>
    <string name="phone_disclosure_calls">Shows who is calling, lets you answer, decline or start calls from your computer, and lists recent calls from the call log</string>
    <string name="phone_disclosure_contacts">Uses your contacts to show names instead of numbers</string>
    <string name="phone_disclosure_local">Texts, calls and contacts go only to your own paired computers, encrypted. They are never sent to us or anyone else</string>
    <string name="phone_disclosure_prompt">Next, Android asks for access to SMS, calls, call logs and contacts.</string>
    <string name="setup_control_stopped_hint">Turn \"FlyyLink computer control\" off and on again</string>
