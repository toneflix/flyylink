<Window
    x:Class="FlyyLink.Views.PanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:FlyyLink.Views"
    xmlns:model="using:FlyyLink.Model"
    xmlns:core="using:FlyyLink.Core"
    Title="FlyyLink">

    <Grid x:Name="Root" Background="{ThemeResource FlyyLinkGlassBrush}">
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Enabled" HorizontalScrollMode="Disabled">
            <StackPanel x:Name="Sections" Padding="14" Spacing="12">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <!-- Header -->
                <Grid Padding="2,0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <views:AppGlyph VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="FlyyLink" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Foreground="{ThemeResource FlyyLinkTextBrush}" />
                    <Button Grid.Column="2" Style="{StaticResource FlyyLinkPlainButton}" ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings">
                        <views:LucideIcon Icon="Settings" Size="15" Foreground="{ThemeResource FlyyLinkSubBrush}" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="SettingsMenu" Placement="BottomEdgeAlignedRight" Opening="SettingsMenu_Opening" />
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!-- Trial -->
                <Border Style="{StaticResource FlyyLinkCard}" Padding="12,10" Visibility="{x:Bind Model.Licence.ShowsTrialBanner, Mode=OneWay}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" CornerRadius="13" Background="{ThemeResource FlyyLinkTintBrush}">
                            <views:LucideIcon Icon="Zap" Size="13" Foreground="{ThemeResource FlyyLinkAccentBrush}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{x:Bind Model.Licence.TrialText, Mode=OneWay}" Style="{StaticResource FlyyLinkCaption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <HyperlinkButton Grid.Column="2" Content="Sign in" Padding="4,0" FontSize="11" VerticalAlignment="Center" Click="LicenceSignIn_Click" />
                        <HyperlinkButton Grid.Column="3" Content="Buy" Padding="4,0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Click="LicenceBuy_Click" />
                    </Grid>
                </Border>

                <!-- Licence: sign in, or why FlyyLink is locked -->
                <Border Style="{StaticResource FlyyLinkCard}" Padding="20" Visibility="{x:Bind Model.Licence.ShowsCard, Mode=OneWay}">
                    <StackPanel Spacing="14">
                        <Grid>
                            <Border Width="56" Height="56" CornerRadius="28" Background="{ThemeResource FlyyLinkTintBrush}" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <views:LucideIcon Icon="Lock" Size="24" Foreground="{ThemeResource FlyyLinkAccentBrush}" />
                            </Border>
                            <Button Style="{StaticResource FlyyLinkPlainButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="LicenceClose_Click" Visibility="{x:Bind Model.Licence.CanClose, Mode=OneWay}" ToolTipService.ToolTip="Close" AutomationProperties.Name="Close">
                                <views:LucideIcon Icon="X" Size="14" Foreground="{ThemeResource FlyyLinkSubBrush}" />
                            </Button>
                        </Grid>

                        <StackPanel Spacing="5">
                            <TextBlock Text="{x:Bind Model.Licence.Title, Mode=OneWay}" Style="{StaticResource FlyyLinkTitle}" FontSize="18" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Model.Licence.Body, Mode=OneWay}" Style="{StaticResource FlyyLinkBody}" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Content="Try again" Style="{StaticResource FlyyLinkPillAccentButton}" HorizontalAlignment="Stretch" Click="LicenceRetry_Click" IsEnabled="{x:Bind Model.Licence.IsIdle, Mode=OneWay}" Visibility="{x:Bind Model.Licence.CanRetry, Mode=OneWay}" />

                        <StackPanel Spacing="10" Visibility="{x:Bind Model.Licence.EntersEmail, Mode=OneWay}">
                            <TextBox x:Name="LicenceEmail" PlaceholderText="Email" InputScope="EmailSmtpAddress" Text="{x:Bind Model.Licence.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="LicenceEmail_KeyDown" />
                            <Button Content="Send code" Style="{StaticResource FlyyLinkPillAccentButton}" HorizontalAlignment="Stretch" Click="LicenceSendCode_Click" IsEnabled="{x:Bind Model.Licence.IsIdle, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Spacing="10" Visibility="{x:Bind Model.Licence.EntersCode, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Model.Licence.CodeHint, Mode=OneWay}" Style="{StaticResource FlyyLinkCaption}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                            <TextBox x:Name="LicenceCode" PlaceholderText="Code" InputScope="Number" MaxLength="6" TextAlignment="Center" FontSize="18" Text="{x:Bind Model.Licence.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="LicenceCode_KeyDown" />
                            <Button Content="Sign in" Style="{StaticResource FlyyLinkPillAccentButton}" HorizontalAlignment="Stretch" Click="LicenceActivate_Click" IsEnabled="{x:Bind Model.Licence.IsIdle, Mode=OneWay}" />
                            <HyperlinkButton Content="Use another email" FontSize="11" HorizontalAlignment="Center" Click="LicenceOtherEmail_Click" />
                        </StackPanel>

                        <ProgressRing IsActive="{x:Bind Model.Licence.IsBusy, Mode=OneWay}" Visibility="{x:Bind Model.Licence.IsBusy, Mode=OneWay}" Width="18" Height="18" />
                        <TextBlock Text="{x:Bind Model.Licence.Error, Mode=OneWay}" Visibility="{x:Bind Model.Licence.HasError, Mode=OneWay}" Foreground="{ThemeResource FlyyLinkWarnBrush}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />

                        <Border Height="1" Background="{ThemeResource FlyyLinkDashBrush}" Opacity="0.5" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Buy FlyyLink" Style="{StaticResource FlyyLinkPillButton}" HorizontalAlignment="Stretch" Click="LicenceBuy_Click" />
                            <Button Grid.Column="1" Content="Your computers" Style="{StaticResource FlyyLinkPillButton}" HorizontalAlignment="Stretch" Click="LicenceAccount_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="12" Visibility="{x:Bind Model.Licence.ShowsApp, Mode=OneWay}">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>

                    <!-- Error -->
                    <Border Style="{StaticResource FlyyLinkCard}" Padding="10" Visibility="{x:Bind Model.HasError, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <views:LucideIcon Icon="TriangleAlert" Size="13" Foreground="{ThemeResource FlyyLinkWarnBrush}" />
                            <TextBlock Text="{x:Bind Model.Error, Mode=OneWay}" Style="{StaticResource FlyyLinkCaption}" TextWrapping="Wrap" MaxWidth="290" />
                        </StackPanel>
                    </Border>

                    <!-- Someone nearby wants to FlyyDrop -->
                    <Border Style="{StaticResource FlyyLinkCard}" Padding="18" Visibility="{x:Bind Model.ShowsFlyyDropAsk, Mode=OneWay}">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="52" Height="52">
                                    <Ellipse x:Name="FlyyDropPulse" Fill="{ThemeResource FlyyLinkTintBrush}" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="FlyyDropPulseScale" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <views:DeviceArt Type="{x:Bind AskType(Model.FlyyDropAsk), Mode=OneWay}" ArtWidth="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Model.FlyyDropAsk.Title, Mode=OneWay, FallbackValue=''}" Style="{StaticResource FlyyLinkTitle}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <views:LucideIcon Icon="{x:Bind AskIcon(Model.FlyyDropAsk), Mode=OneWay}" Size="12" Foreground="{ThemeResource FlyyLinkAccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind Model.FlyyDropAsk.Summary, Mode=OneWay, FallbackValue=''}" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource FlyyLinkTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="230" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Decline" Style="{StaticResource FlyyLinkPillButton}" HorizontalAlignment="Stretch" Click="DeclineFlyyDrop_Click" />
                                <Button Grid.Column="1" Content="Accept" Style="{StaticResource FlyyLinkPillAccentButton}" HorizontalAlignment="Stretch" Click="AcceptFlyyDrop_Click" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <views:LucideIcon Icon="Lock" Size="11" Foreground="{ThemeResource FlyyLinkSubBrush}" />
                                <TextBlock Text="{x:Bind Model.FlyyDropAsk.Hint, Mode=OneWay, FallbackValue=''}" FontSize="10.5" Foreground="{ThemeResource FlyyLinkSubBrush}" TextWrapping="Wrap" MaxWidth="280" TextAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Visible to everyone nearby -->
                    <Border Style="{StaticResource FlyyLinkCard}" Padding="10,8" Visibility="{x:Bind Model.ShowsFlyyDropBanner, Mode=OneWay}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="26" Height="26" CornerRadius="13" Background="{ThemeResource FlyyLinkTintBrush}">
                                <views:LucideIcon Icon="Radar" Size="13" Foreground="{ThemeResource FlyyLinkAccentBrush}" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{x:Bind Model.FlyyDropBannerText, Mode=OneWay}" Style="{StaticResource FlyyLinkCaption}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <HyperlinkButton Grid.Column="2" Content="Turn off" Padding="4,0" FontSize="11" VerticalAlignment="Center" Click="StopFlyyDropReceiving_Click" />
                        </Grid>
                    </Border>

                    <!-- No phone yet -->
                    <Border Style="{StaticResource FlyyLinkCard}" Padding="18" Visibility="{x:Bind Model.ShowsSearching, Mode=OneWay}">
                        <StackPanel Spacing="14" Padding="0,10">
                            <Grid Height="96" HorizontalAlignment="Center">
                                <Ellipse x:Name="PulseOne" Width="64" Height="64" StrokeThickness="1.5" Stroke="{ThemeResource FlyyLinkAccentBrush}" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="PulseOneScale" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="PulseTwo" Width="64" Height="64" StrokeThickness="1.5" Stroke="{ThemeResource FlyyLinkAccentBrush}" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="PulseTwoScale" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse Width="64" Height="64" Fill="{ThemeResource FlyyLinkTintBrush}" />
                                <views:PhoneArt ArtWidth="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{x:Bind SearchingTitle(Model.HasOthers), Mode=OneWay}" Style="{StaticResource FlyyLinkTitle}" HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind SearchingHint(Model.HasOthers), Mode=OneWay}" Style="{StaticResource FlyyLinkBody}" TextAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- A paired phone is in Bluetooth range but not on this network -->
                    <Border Style="{StaticResource FlyyLinkCard}" Padding="18" Visibility="{x:Bind Model.ShowsHotspot, Mode=OneWay}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="32" Height="32" CornerRadius="16" Background="{ThemeResource FlyyLinkTintBrush}">
                                    <views:LucideIcon Icon="Wifi" Size="15" Foreground="{ThemeResource FlyyLinkAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Your phone is nearby" Style="{StaticResource FlyyLinkTitle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind Model.HotspotText, Mode=OneWay}" Style="{StaticResource FlyyLinkBody}" TextWrapping="Wrap" />
                            <Button Content="{x:Bind Model.HotspotButton, Mode=OneWay}" Style="{StaticResource FlyyLinkPillAccentButton}" HorizontalAlignment="Stretch" Click="JoinHotspot_Click" Visibility="{x:Bind Model.CanJoinHotspot, Mode=OneWay}" />
                            <Button Content="Cancel" Style="{StaticResource FlyyLinkPillButton}" HorizontalAlignment="Stretch" Click="CancelHotspot_Click" Visibility="{x:Bind Model.IsJoiningHotspot, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <!-- Pairing -->
                    <Border Style="{StaticResource FlyyLinkCard}" Padding="20" Visibility="{x:Bind Model.ShowsPairing, Mode=OneWay}">
                        <StackPanel Spacing="18">
                            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <views:PhoneArt ArtWidth="36" />
                                <StackPanel x:Name="SignalDots" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Ellipse x:Name="DotOne" Width="6" Height="6" Fill="{ThemeResource FlyyLinkAccentBrush}" />
                                    <Ellipse x:Name="DotTwo" Width="6" Height="6" Fill="{ThemeResource FlyyLinkAccentBrush}" Opacity="0.3" />
                                    <Ellipse x:Name="DotThree" Width="6" Height="6" Fill="{ThemeResource FlyyLinkAccentBrush}" Opacity="0.3" />
                                </StackPanel>
                                <views:LaptopArt />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind Model.Focused.PairingTitle, Mode=OneWay, FallbackValue=''}" Style="{StaticResource FlyyLinkTitle}" FontSize="18" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                                <TextBlock Text="{x:Bind Model.Focused.PairingHint, Mode=OneWay, FallbackValue=''}" Style="{StaticResource FlyyLinkBody}" TextAlignment="Center" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{x:Bind Model.Focused.CodeCharacters, Mode=OneWay}" HorizontalAlignment="Center" AutomationProperties.Name="Verification code">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="5" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Width="28" Height="40" CornerRadius="8" Background="{ThemeResource FlyyLinkTintBrush}">
                                            <TextBlock Text="{x:Bind}" FontFamily="Consolas" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource FlyyLinkAccentStrongBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ProgressRing IsActive="{x:Bind Model.Focused.IsOurRequest, Mode=OneWay, FallbackValue=False}" Visibility="{x:Bind Model.Focused.IsOurRequest, Mode=OneWay, FallbackValue=Collapsed}" Width="20" Height="20" />

                            <Grid ColumnSpacing="8" Visibility="{x:Bind Model.Focused.IsTheirRequest, Mode=OneWay, FallbackValue=Collapsed}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Not now" Style="{StaticResource FlyyLinkPillButton}" Click="Reject_Click" />
                                <Button Grid.Column="1" Content="Pair" Style="{StaticResource FlyyLinkPillAccentButton}" Click="Accept_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- The paired phone or computer -->
                    <StackPanel Spacing="12" Visibility="{x:Bind Model.ShowsPhone, Mode=OneWay}">
                        <!-- In the carousel the next phone's card peeks out at the panel's edge. -->
                        <Grid ColumnSpacing="8" Margin="{x:Bind CarouselBleed(Model.ShowsCarousel), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Hero" Background="{StaticResource FlyyLinkGoldBrush}" CornerRadius="{StaticResource FlyyLinkRadius}" Padding="16" RequestedTheme="Light">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="HeroShift" />
                            </Border.RenderTransform>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <views:DeviceArt Type="{x:Bind FocusedType(Model.Focused), Mode=OneWay}" ArtWidth="{x:Bind HeroArtWidth(Model.Focused), Mode=OneWay}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <Button x:Name="PhoneName" Style="{StaticResource FlyyLinkPlainButton}" Padding="0" IsEnabled="{x:Bind Model.ShowsDeviceList, Mode=OneWay}" ToolTipService.ToolTip="Switch to another device">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <views:LucideIcon Icon="ChevronDown" Size="11" Foreground="#5A4A10" VerticalAlignment="Center" Visibility="{x:Bind Model.ShowsDeviceList, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind Model.Focused.Name, Mode=OneWay, FallbackValue=''}" FontSize="16" FontWeight="Bold" Foreground="#1B1B1F" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <MenuFlyout x:Name="PhoneMenu" Opening="PhoneMenu_Opening" />
                                        </Button.Flyout>
                                    </Button>
                                    <Border Background="{ThemeResource FlyyLinkOkTintBrush}" CornerRadius="10" Padding="9,4" HorizontalAlignment="Left" ToolTipService.ToolTip="Connected over Wi-Fi">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="7" Height="7" Fill="{ThemeResource FlyyLinkOkBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="Connected" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource FlyyLinkOkBrush}" />
                                            <views:LucideIcon Icon="Wifi" Size="11" Foreground="{ThemeResource FlyyLinkOkBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Width="24" Height="24" Padding="0" CornerRadius="12" Style="{StaticResource FlyyLinkPlainButton}" Background="{x:Bind StatusBackground(Model.MirrorsNotifications), Mode=OneWay}" Click="Notifications_Click"
                                                ToolTipService.ToolTip="{x:Bind NotificationsHint(Model.MirrorsNotifications), Mode=OneWay}" AutomationProperties.Name="{x:Bind NotificationsHint(Model.MirrorsNotifications), Mode=OneWay}">
                                            <views:LucideIcon Icon="{x:Bind HeroBell(Model.MirrorsNotifications), Mode=OneWay}" Size="12" Foreground="#4A4030" Opacity="{x:Bind StatusOpacity(Model.MirrorsNotifications), Mode=OneWay}" />
                                        </Button>
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#14000000" ToolTipService.ToolTip="Clipboard synced" AutomationProperties.Name="Clipboard synced">
                                            <views:LucideIcon Icon="Clipboard" Size="12" Foreground="#4A4030" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <views:BatteryRing Grid.Column="2" VerticalAlignment="Center" Visibility="{x:Bind ShowsBattery(Model.Focused), Mode=OneWay}" Charge="{x:Bind BatteryCharge(Model.Focused), Mode=OneWay}" IsCharging="{x:Bind Model.Focused.IsCharging, Mode=OneWay, FallbackValue=False}" />
                            </Grid>
                        </Border>
                        <Button Grid.Column="1" Width="22" Padding="0" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Style="{StaticResource FlyyLinkPlainButton}" Visibility="{x:Bind Model.ShowsCarousel, Mode=OneWay}"
                                Click="NextPhone_Click" ToolTipService.ToolTip="{x:Bind NextTitle(Model.NextPhone), Mode=OneWay}" AutomationProperties.Name="{x:Bind NextTitle(Model.NextPhone), Mode=OneWay}">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                            </Button.Resources>
                            <Border Background="{StaticResource FlyyLinkGoldBrush}" CornerRadius="14,0,0,14" Opacity="0.75" RequestedTheme="Light">
                                <views:LucideIcon Icon="ChevronRight" Size="12" Foreground="#5A4A10" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </Border>
                        </Button>
                        </Grid>

                        <!-- Find the phone: where it is, after asking it to ring -->
                        <Border Style="{StaticResource FlyyLinkCard}" Padding="12" Visibility="{x:Bind IsFinding(Model.Finding, Model.Focused), Mode=OneWay}">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <views:LucideIcon Icon="MapPin" Size="13" Foreground="{ThemeResource FlyyLinkAccentBrush}" />
                                        <TextBlock Text="{x:Bind FindTitle(Model.Focused), Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource FlyyLinkAccentBrush}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                    </StackPanel>
                                    <Button Style="{StaticResource FlyyLinkPlainButton}" HorizontalAlignment="Right" Padding="2" Click="StopFinding_Click" ToolTipService.ToolTip="Hide the map" AutomationProperties.Name="Hide the map">
                                        <views:LucideIcon Icon="CircleX" Size="14" Foreground="{ThemeResource FlyyLinkSubBrush}" />
                                    </Button>
                                </Grid>
                                <Grid Height="170" CornerRadius="10" Background="{ThemeResource FlyyLinkThumbBrush}">
                                    <WebView2 x:Name="Map" Visibility="{x:Bind HasLocation(Model.Found), Mode=OneWay}" />
                                    <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind NoLocation(Model.Found), Mode=OneWay}">
                                        <ProgressRing IsActive="{x:Bind IsLocating(Model.Found), Mode=OneWay}" Width="18" Height="18" />
                                        <TextBlock Text="Ringing…" Style="{StaticResource FlyyLinkCaption}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Visibility="{x:Bind HasLocation(Model.Found), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind LocationDetail(Model.Found), Mode=OneWay}" Style="{StaticResource FlyyLinkCaption}" VerticalAlignment="Center" />
                                    <HyperlinkButton HorizontalAlignment="Right" Padding="4,0" FontSize="11" FontWeight="SemiBold" Click="OpenMap_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="Open map" />
                                            <views:LucideIcon Icon="ExternalLink" Size="11" Foreground="{ThemeResource FlyyLinkAccentBrush}" />
                                        </StackPanel>
                                    </HyperlinkButton>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- What the phone is playing -->
                        <Border Style="{StaticResource FlyyLinkCard}" Padding="12" Visibility="{x:Bind HasMedia(Model.Focused), Mode=OneWay}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="46" Height="46" CornerRadius="9" Background="{ThemeResource FlyyLinkTintBrush}">
                                        <views:LucideIcon Icon="Music" Size="18" Foreground="{ThemeResource FlyyLinkAccentBrush}" />
                                        <Image Source="{x:Bind Artwork(Model.Focused), Mode=OneWay}" Stretch="UniformToFill" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind MediaTitle(Model.Focused), Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource FlyyLinkTextBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind MediaSubtitle(Model.Focused), Mode=OneWay}" Style="{StaticResource FlyyLinkCaption}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Button Style="{StaticResource FlyyLinkPlainButton}" Width="32" Height="32" CornerRadius="16" Padding="0" Tag="Previous" Click="Media_Click" IsEnabled="{x:Bind CanGoPrevious(Model.Focused), Mode=OneWay}" ToolTipService.ToolTip="Previous" AutomationProperties.Name="Previous">
                                            <views:LucideIcon Icon="SkipBack" Size="13" Foreground="{ThemeResource FlyyLinkTextBrush}" />
                                        </Button>
                                        <Button Style="{StaticResource FlyyLinkPlainButton}" Width="36" Height="36" CornerRadius="18" Padding="0" Tag="PlayPause" Click="Media_Click" ToolTipService.ToolTip="Play or pause" AutomationProperties.Name="Play or pause">
                                            <views:LucideIcon Icon="{x:Bind PlayIcon(Model.Focused), Mode=OneWay}" Size="17" Foreground="{ThemeResource FlyyLinkTextBrush}" />
                                        </Button>
                                        <Button Style="{StaticResource FlyyLinkPlainButton}" Width="32" Height="32" CornerRadius="16" Padding="0" Tag="Next" Click="Media_Click" IsEnabled="{x:Bind CanGoNext(Model.Focused), Mode=OneWay}" ToolTipService.ToolTip="Next" AutomationProperties.Name="Next">
                                            <views:LucideIcon Icon="SkipForward" Size="13" Foreground="{ThemeResource FlyyLinkTextBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Grid x:Name="MediaTrack" Height="10" Background="Transparent" PointerPressed="MediaTrack_PointerPressed" Visibility="{x:Bind HasLength(Model.Focused), Mode=OneWay}">
                                    <ProgressBar x:Name="MediaProgress" Maximum="1" VerticalAlignment="Center" IsHitTestVisible="False" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid ColumnSpacing="10" RowSpacing="10" Visibility="{x:Bind Model.FocusIsPhone, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <views:ActionTile Icon="Volume2" Title="Ring phone" Click="Ring_Click" />
                            <views:ActionTile Grid.Column="1" Icon="FileUp" Title="Send file" Click="SendFiles_Click" />
                            <views:ActionTile Grid.Row="1" Icon="Clipboard" Title="Clipboard" Subtitle="{x:Bind Model.ClipboardSubtitle, Mode=OneWay}" Click="Clipboard_Click" />
                            <views:ActionTile Grid.Row="1" Grid.Column="1" Icon="{x:Bind NotificationsIcon(Model.MirrorsNotifications), Mode=OneWay}" Title="Notifications" Subtitle="{x:Bind Model.NotificationsSubtitle, Mode=OneWay}" IsOn="{x:Bind Model.MirrorsNotifications, Mode=OneWay}" Click="Notifications_Click" />
                            <views:ActionTile Grid.Row="2" Icon="MessageSquare" Title="Messages" Subtitle="{x:Bind Model.MessagesSubtitle, Mode=OneWay}" Click="Messages_Click" />
                            <views:ActionTile Grid.Row="2" Grid.Column="1" Icon="Phone" Title="Call" Click="Call_Click" />
                            <views:ActionTile Grid.Row="3" Icon="Cast" Title="Mirror" Click="Mirror_Click" />
                            <views:ActionTile Grid.Row="3" Grid.Column="1" Icon="Images" Title="Photos" Click="Photos_Click" />
                        </Grid>

                        <!-- Things to do with a TV -->
                        <Grid ColumnSpacing="10" Visibility="{x:Bind Model.FocusIsTv, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <views:ActionTile Icon="FileUp" Title="Send file" Click="SendFiles_Click" />
                            <views:ActionTile Grid.Column="1" Icon="Link" Title="Open link" Subtitle="From your clipboard" Click="OpenLink_Click" />
                        </Grid>

                        <!-- Things to do with another computer -->
                        <Grid x:Name="ComputerTiles" ColumnSpacing="10" RowSpacing="10" Visibility="{x:Bind Model.FocusIsComputer, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <views:ActionTile Icon="Volume2" Title="Play sound" Click="Ring_Click" />
                            <views:ActionTile Grid.Column="1" Icon="FileUp" Title="Send file" Click="SendFiles_Click" />
                            <views:ActionTile Grid.Row="1" Icon="Clipboard" Title="Clipboard" Subtitle="{x:Bind Model.ClipboardSubtitle, Mode=OneWay}" Click="Clipboard_Click" />
                            <views:ActionTile Grid.Row="1" Grid.Column="1" Icon="{x:Bind NotificationsIcon(Model.MirrorsNotifications), Mode=OneWay}" Title="Notifications" Subtitle="{x:Bind Model.NotificationsSubtitle, Mode=OneWay}" IsOn="{x:Bind Model.MirrorsNotifications, Mode=OneWay}" Click="Notifications_Click" />
                        </Grid>

                        <!-- The other computer's screen, and whether it is watching this one -->
                        <Border Style="{StaticResource FlyyLinkCard}" Padding="12" Visibility="{x:Bind Model.FocusIsComputer, Mode=OneWay}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="9" Background="{x:Bind InputChip(Model.FocusWatchesScreen), Mode=OneWay}">
                                    <views:LucideIcon Icon="ScreenShare" Size="14" Foreground="{x:Bind InputGlyph(Model.FocusWatchesScreen), Mode=OneWay}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="Screen" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource FlyyLinkTextBrush}" />
                                    <TextBlock Text="{x:Bind Model.ScreenStatus, Mode=OneWay}" Style="{StaticResource FlyyLinkCaption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="View" Style="{StaticResource AccentButtonStyle}" CornerRadius="8" VerticalAlignment="Center" Click="ViewScreen_Click" Visibility="{x:Bind Hidden(Model.FocusWatchesScreen), Mode=OneWay}" />
                                <Button Grid.Column="2" Content="Stop" CornerRadius="8" VerticalAlignment="Center" Click="StopScreenShare_Click" Visibility="{x:Bind Model.FocusWatchesScreen, Mode=OneWay}" />
                            </Grid>
                        </Border>

                        <!-- Where the other computer sits, so the keyboard and mouse move across to it -->
                        <Border Style="{StaticResource FlyyLinkCard}" Padding="12" Visibility="{x:Bind Model.FocusIsComputer, Mode=OneWay}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="9" Background="{x:Bind InputChip(Model.InputActive), Mode=OneWay}">
                                        <views:LucideIcon Icon="MousePointer2" Size="14" Foreground="{x:Bind InputGlyph(Model.InputActive), Mode=OneWay}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="Keyboard and mouse" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource FlyyLinkTextBrush}" />
                                        <TextBlock Text="{x:Bind Model.InputStatus, Mode=OneWay}" Style="{StaticResource FlyyLinkCaption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <Grid x:Name="EdgePicker" ColumnSpacing="4" />
                            </StackPanel>
                        </Border>

                        <!-- Drop files to send them -->
                        <Grid x:Name="DropZone" Height="64" AllowDrop="True" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave" Drop="DropZone_Drop" Tapped="DropZone_Tapped" PointerEntered="DropZone_PointerEntered" PointerExited="DropZone_PointerExited" Background="Transparent" ToolTipService.ToolTip="Choose files to send">
                            <Rectangle x:Name="DropOutline" RadiusX="14" RadiusY="14" StrokeThickness="1.5" StrokeDashArray="4,3" Stroke="{ThemeResource FlyyLinkDashBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <views:LucideIcon Icon="Download" Size="14" Foreground="{ThemeResource FlyyLinkSubBrush}" />
                                <TextBlock x:Name="DropLabel" Text="Drop files or links to send" FontSize="12" Foreground="{ThemeResource FlyyLinkSubBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Play on TV: choose a file, pick a TV, then control what it plays. Shown only while a TV is around -->
                    <Border Style="{StaticResource FlyyLinkCard}" Padding="10" Visibility="{x:Bind Model.PlayOnTv.IsShown, Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <Button Style="{StaticResource FlyyLinkPlainButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Click="PlayOnTv_Click" Visibility="{x:Bind Model.PlayOnTv.IsIdle, Mode=OneWay}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="9" Background="{ThemeResource FlyyLinkTintBrush}">
                                        <views:LucideIcon Icon="Cast" Size="15" Foreground="{ThemeResource FlyyLinkAccentBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="Play on TV" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource FlyyLinkTextBrush}" />
                                        <TextBlock Text="{x:Bind Model.PlayOnTv.IdleStatus, Mode=OneWay}" Style="{StaticResource FlyyLinkCaption}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <StackPanel Spacing="8" Visibility="{x:Bind Model.PlayOnTv.IsPicking, Mode=OneWay}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="9" Background="{ThemeResource FlyyLinkTintBrush}">
                                        <views:LucideIcon Icon="{x:Bind Model.PlayOnTv.PickedIcon, Mode=OneWay}" Size="15" Foreground="{ThemeResource FlyyLinkAccentBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{x:Bind Model.PlayOnTv.PickedName, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource FlyyLinkTextBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Model.PlayOnTv.PickStatus, Mode=OneWay}" Style="{StaticResource FlyyLinkCaption}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <ProgressRing IsActive="{x:Bind Model.PlayOnTv.Searching, Mode=OneWay}" Width="16" Height="16" />
                                        <HyperlinkButton Content="Search again" Padding="4,0" FontSize="11" Click="SearchTvs_Click" Visibility="{x:Bind Model.PlayOnTv.ShowsSearchAgain, Mode=OneWay}" />
                                        <Button Style="{StaticResource FlyyLinkPlainButton}" Width="30" Height="30" CornerRadius="15" Padding="0" Click="CancelTvPick_Click" ToolTipService.ToolTip="Cancel" AutomationProperties.Name="Cancel">
                                            <views:LucideIcon Icon="X" Size="13" Foreground="{ThemeResource FlyyLinkSubBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{x:Bind Model.PlayOnTv.Tvs, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="core:TvRenderer">
                                            <Button Style="{StaticResource FlyyLinkPlainButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="34" Margin="0,0,0,4" Padding="10,0" CornerRadius="8" Background="{ThemeResource FlyyLinkThumbBrush}" Tag="{x:Bind Id}" Click="PlayOnTvTarget_Click">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <views:LucideIcon Icon="Cast" Size="13" Foreground="{ThemeResource FlyyLinkAccentBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource FlyyLinkTextBrush}" />
                                                    <views:LucideIcon Grid.Column="2" Icon="Play" Size="11" Foreground="{ThemeResource FlyyLinkSubBrush}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="10" Visibility="{x:Bind Model.PlayOnTv.IsPlaying, Mode=OneWay}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="9" Background="{ThemeResource FlyyLinkTintBrush}">
                                        <views:LucideIcon Icon="{x:Bind Model.PlayOnTv.PlayingIcon, Mode=OneWay}" Size="15" Foreground="{ThemeResource FlyyLinkAccentBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{x:Bind Model.PlayOnTv.PlayingName, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource FlyyLinkTextBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Model.PlayOnTv.PlayingStatus, Mode=OneWay}" Style="{StaticResource FlyyLinkCaption}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <ProgressRing IsActive="{x:Bind Model.PlayOnTv.IsLoading, Mode=OneWay}" Width="16" Height="16" Margin="8,0" Visibility="{x:Bind Model.PlayOnTv.IsLoading, Mode=OneWay}" />
                                        <Button Style="{StaticResource FlyyLinkPlainButton}" Width="36" Height="36" CornerRadius="18" Padding="0" Click="TvPlayPause_Click" Visibility="{x:Bind Model.PlayOnTv.ShowsPlayPause, Mode=OneWay}" ToolTipService.ToolTip="Play or pause" AutomationProperties.Name="Play or pause">
                                            <views:LucideIcon Icon="{x:Bind Model.PlayOnTv.PlayPauseIcon, Mode=OneWay}" Size="17" Foreground="{ThemeResource FlyyLinkTextBrush}" />
                                        </Button>
                                        <Button Style="{StaticResource FlyyLinkPlainButton}" Width="32" Height="32" CornerRadius="16" Padding="0" Click="TvStop_Click" ToolTipService.ToolTip="Stop" AutomationProperties.Name="Stop">
                                            <views:LucideIcon Icon="X" Size="13" Foreground="{ThemeResource FlyyLinkTextBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Grid x:Name="TvTrack" Height="10" Background="Transparent" PointerPressed="TvTrack_PointerPressed" Visibility="{x:Bind Model.PlayOnTv.HasDuration, Mode=OneWay}">
                                    <ProgressBar Maximum="1" Value="{x:Bind Model.PlayOnTv.Progress, Mode=OneWay}" VerticalAlignment="Center" IsHitTestVisible="False" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Other devices -->
                    <Border Style="{StaticResource FlyyLinkCard}" Padding="12" Visibility="{x:Bind Model.HasOthers, Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="ALSO NEARBY" Style="{StaticResource FlyyLinkSectionHeader}" />
                            <ItemsControl ItemsSource="{x:Bind Model.Others, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="model:DeviceState">
                                        <Grid ColumnSpacing="10" Padding="0,4" CornerRadius="8" Background="Transparent" Tag="{x:Bind Id}" AllowDrop="True" DragOver="Row_DragOver" DragLeave="Row_DragLeave" Drop="Row_Drop">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="8" Background="{ThemeResource FlyyLinkTintBrush}">
                                                <views:LucideIcon Icon="{x:Bind views:PanelWindow.RowIcon(Type)}" Size="14" Foreground="{ThemeResource FlyyLinkAccentBrush}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource FlyyLinkTextBrush}" />
                                                <TextBlock Text="{x:Bind RowSubtitle}" Style="{StaticResource FlyyLinkCaption}" TextTrimming="CharacterEllipsis" />
                                                <ProgressBar Value="{x:Bind FlyyDropPercent}" Margin="0,4,0,0" Visibility="{x:Bind IsFlyyDropSending}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Width="30" Height="30" Padding="0" CornerRadius="15" Tag="{x:Bind Id}" Click="FlyyDrop_Click" VerticalAlignment="Center" Visibility="{x:Bind ShowsFlyyDrop}"
                                                    ToolTipService.ToolTip="{x:Bind FlyyDropHint}" AutomationProperties.Name="{x:Bind FlyyDropHint}">
                                                <views:LucideIcon Icon="{x:Bind FlyyDropIcon}" Size="14" Foreground="{ThemeResource FlyyLinkAccentBrush}" />
                                            </Button>
                                            <Button Grid.Column="3" Content="{x:Bind views:PanelWindow.RowAction(PairState)}" Tag="{x:Bind Id}" Click="RowAction_Click" VerticalAlignment="Center" CornerRadius="8" Padding="12,4" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Recent -->
                    <Border Style="{StaticResource FlyyLinkCard}" Padding="12" Visibility="{x:Bind Model.HasRecent, Mode=OneWay}">
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="RECENT" Style="{StaticResource FlyyLinkSectionHeader}" VerticalAlignment="Center" />
                                <HyperlinkButton Content="Clear" HorizontalAlignment="Right" Padding="4,0" FontSize="11" Click="ClearRecent_Click" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind Model.Recent}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="model:Activity">
                                        <Button Style="{StaticResource FlyyLinkPlainButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="4,6" Tag="{x:Bind}" Click="Activity_Click" ContextRequested="Activity_ContextRequested" ToolTipService.ToolTip="{x:Bind Hint}">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="30" CornerRadius="8" Background="{ThemeResource FlyyLinkThumbBrush}" VerticalAlignment="Top">
                                                    <views:LucideIcon Icon="{x:Bind Icon}" Size="14" Foreground="{ThemeResource FlyyLinkAccentBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{x:Bind Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource FlyyLinkTextBrush}" />
                                                    <TextBlock Text="{x:Bind Caption}" Style="{StaticResource FlyyLinkCaption}" />
                                                    <ProgressBar Value="{x:Bind ProgressPercent}" Visibility="{x:Bind ShowsProgress}" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Notifications unavailable -->
                    <Border Style="{StaticResource FlyyLinkCard}" Padding="10" Visibility="{x:Bind NotificationsMissing}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <views:LucideIcon Icon="BellOff" Size="13" Foreground="{ThemeResource FlyyLinkWarnBrush}" />
                            <TextBlock Text="Windows notifications are off for FlyyLink." Style="{StaticResource FlyyLinkCaption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Footer -->
                <Grid Padding="4,0">
                    <TextBlock Text="{x:Bind Model.ThisComputer}" Style="{StaticResource FlyyLinkCaption}" VerticalAlignment="Center" MaxWidth="250" HorizontalAlignment="Left" />
                    <HyperlinkButton Content="Quit" HorizontalAlignment="Right" Padding="4,0" FontSize="11" Click="Quit_Click" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
